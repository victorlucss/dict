{
  "productName": "MegaBrain",
  "version": "0.9.5",
  "identifier": "com.dict.dictation",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src http://localhost:* https://*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist",
      "frameworks": [
        "native-libs/libonnxruntime.1.17.1.dylib",
        "native-libs/libsherpa-onnx-c-api.dylib"
      ],
      "exceptionDomain": ""
    },
    "linux": {
      "deb": {
        "depends": ["libasound2-dev"]
      }
    },
    "windows": {
      "wix": {}
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NDAzQTcxMDg0RUIxQjMKUldTenNVNEljVHBBZEhFOXNsU0hHRmllWDMrdVBqa1BuOWdoQ3pZdHhERmlNQ1Y5QnhYa3JCRUUK",
      "endpoints": [
        "https://github.com/victorlucss/megabrain/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
